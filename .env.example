# Variables opcionales. La app no necesita cuentas ni claves: todo es local.
# Copia este archivo a .env.local solo si quieres cambiar algo de esto.

# Ruta fija a yt-dlp (la app no lo actualizará mientras esté puesta).
ALFORJA_YTDLP=
# Ruta fija a ffmpeg.
ALFORJA_FFMPEG=
# Origen de las actualizaciones del motor. Por defecto, la API pública de GitHub
# de yt-dlp. Solo para pruebas con un servidor local.
ALFORJA_RELEASES_URL=
# Servidor local para las pruebas de integración (scripts/test_server.py).
ALFORJA_TEST_SERVER=
